generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    @default("RESPONSABLE")
  isActive           Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  avatarUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plannings          Planning[]
  meetings           Meeting[] @relation("organizer")
  invitations        Invitation[]
  bookings           RoomBooking[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  missionsCreated    Mission[] @relation("MissionsCreated")
  missionAssignments MissionAssignment[]
  passwordHistory    PasswordHistory[]
  meetingFiles       MeetingFile[]
  missionFiles       MissionFile[]
  meetingMessages    MeetingMessage[]
  sentDirectMessages DirectMessage[] @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[] @relation("DirectMessageReceiver")

  twoFactorSecret    String?
  twoFactorEnabled   Boolean  @default(false)

  deviceTokens       DeviceToken[]

  backupsCreated     Backup[]       @relation("BackupCreatedBy")
  projectsCreated    Project[]      @relation("ProjectCreatedBy")
  projectFiles       ProjectFile[]
  directionId        String?
  direction          Direction? @relation("DirectionMembers", fields: [directionId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?   @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: SetNull)

  /// Téléphone professionnel (affichage annuaire interne)
  phone              String?
  /// Intitulé de poste / fonction
  jobTitle           String?
  /// Cellule ou service au sein de la direction (texte libre)
  cellUnit           String?
  directionMessages  DirectionMessage[]
  directionDiscussionMemberships DirectionDiscussionMember[]
  projectMessages    ProjectMessage[]
  projectDiscussionMemberships ProjectDiscussionMember[]
  projectsAsConsolidator Project[] @relation("ProjectConsolidator")
  projectsAsCoordinator  Project[] @relation("ProjectCoordinator")
  projectsAsResponsible  Project[] @relation("ProjectResponsible")

  @@index([directionId])
  @@index([projectId])
}

/// Sauvegardes PostgreSQL (pg_dump) — super admin
model Backup {
  id            String    @id @default(cuid())
  fileName      String
  relativePath  String
  sizeBytes     Int?
  status        String    @default("PENDING") // PENDING | SUCCESS | FAILED
  errorMessage  String?
  kind          String    @default("MANUAL") // MANUAL | SCHEDULED
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdById   String?
  createdBy     User?     @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([status])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // 'android' | 'ios' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  parentId   String?
  body       String?
  fileName   String?
  fileUrl    String?
  mimeType   String?
  size       Int?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  parent     DirectMessage?  @relation("DirectMessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    DirectMessage[] @relation("DirectMessageReplies")

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, senderId, isRead])
  @@index([parentId])
}

model Room {
  id                 String    @id @default(cuid())
  name               String    @unique
  capacity           Int
  location           String
  equipment          String
  openFrom           String    @default("08:00")
  openTo             String    @default("19:00")
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  planningEvents     PlanningEvent[]
  meetings           Meeting[]
  bookings           RoomBooking[]
}

/// Types d'événements configurables (réunions, lignes de planning, etc.)
model EventType {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  color        String   @default("#1565C0")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meetings         Meeting[]
  planningEvents   PlanningEvent[]

  @@index([isActive, sortOrder])
}

model Planning {
  id                 String    @id @default(cuid())
  userId             String
  weekStart          DateTime
  submittedAt        DateTime?
  consolidatedAt     DateTime?
  validatedAt        DateTime?
  returnedAt         DateTime?
  status             String    @default("DRAFT")
  returnComment      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id])
  events             PlanningEvent[]

  @@unique([userId, weekStart])
}

model PlanningEvent {
  id                 String    @id @default(cuid())
  planningId         String
  title              String
  type               String
  eventTypeId        String?
  startTime          DateTime
  endTime            DateTime
  roomId             String?
  directionId        String?
  projectId          String?
  destination        String?
  description        String?
  createdAt          DateTime  @default(now())

  planning           Planning  @relation(fields: [planningId], references: [id], onDelete: Cascade)
  room               Room?     @relation(fields: [roomId], references: [id])
  direction          Direction? @relation(fields: [directionId], references: [id])
  project            Project?   @relation(fields: [projectId], references: [id])
  eventType          EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  @@index([directionId])
  @@index([projectId])
  @@index([eventTypeId])
}

model Meeting {
  id                 String    @id @default(cuid())
  title              String
  agenda             String
  organizerId        String
  roomId             String?
  directionId        String?
  projectId          String?
  eventTypeId        String?
  meetingLink        String?
  startTime          DateTime
  endTime            DateTime
  status             String    @default("DRAFT")
  orderOfDay         String?
  attachments        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organizer          User      @relation("organizer", fields: [organizerId], references: [id])
  room               Room?     @relation(fields: [roomId], references: [id])
  direction          Direction? @relation(fields: [directionId], references: [id])
  project            Project?   @relation(fields: [projectId], references: [id])
  eventType          EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  invitations        Invitation[]
  booking            RoomBooking?
  files              MeetingFile[]
  messages           MeetingMessage[]

  @@index([directionId])
  @@index([projectId])
  @@index([eventTypeId])
}

model MeetingFile {
  id           String   @id @default(cuid())
  meetingId    String
  uploadedById String
  kind         String   @default("DOCUMENT")
  fileName     String
  fileUrl      String
  mimeType     String?
  size         Int?
  createdAt    DateTime @default(now())

  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([meetingId, createdAt])
}

model MeetingMessage {
  id         String   @id @default(cuid())
  meetingId  String
  senderId   String
  body       String
  parentId   String?
  createdAt  DateTime @default(now())

  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])
  parent     MeetingMessage?  @relation("MeetingMessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    MeetingMessage[] @relation("MeetingMessageReplies")

  @@index([meetingId, createdAt])
  @@index([parentId])
}

model Invitation {
  id                 String    @id @default(cuid())
  meetingId          String
  userId             String
  status             String    @default("PENDING")
  sentAt             DateTime?
  respondedAt        DateTime?
  createdAt          DateTime  @default(now())

  meeting            Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model RoomBooking {
  id                 String    @id @default(cuid())
  roomId             String
  meetingId          String?   @unique
  userId             String
  date               DateTime
  startTime          String
  endTime            String
  status             String    @default("CONFIRMED")
  createdAt          DateTime  @default(now())

  room               Room      @relation(fields: [roomId], references: [id])
  meeting            Meeting?  @relation(fields: [meetingId], references: [id])
  bookedBy           User      @relation(fields: [userId], references: [id])
}

model Notification {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  title              String
  body               String
  link               String?
  isRead             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id                 String    @id @default(cuid())
  userId             String?
  action             String
  entity             String
  entityId           String
  ipAddress          String?
  details            String?
  createdAt          DateTime  @default(now())

  user               User?     @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id                 String    @id @default(cuid())
  userId             String
  token              String    @unique
  expiresAt          DateTime
  isRevoked          Boolean   @default(false)
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mission {
  id           String    @id @default(cuid())
  title        String
  description  String?
  location     String
  startTime    DateTime
  endTime      DateTime
  directionId  String?
  projectId    String?
  createdById  String
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy    User      @relation("MissionsCreated", fields: [createdById], references: [id])
  direction    Direction? @relation(fields: [directionId], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])
  assignments  MissionAssignment[]
  files        MissionFile[]

  @@index([directionId])
  @@index([projectId])
}

model MissionFile {
  id           String   @id @default(cuid())
  missionId    String
  uploadedById String
  kind         String   @default("DOCUMENT")
  fileName     String
  fileUrl      String
  mimeType     String?
  size         Int?
  createdAt    DateTime @default(now())

  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([missionId, createdAt])
}

model MissionAssignment {
  id        String   @id @default(cuid())
  missionId String
  userId    String
  createdAt DateTime @default(now())

  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([missionId, userId])
}

// Paramètres globaux de l'application (admin)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Direction {
  id            String         @id @default(cuid())
  name          String
  code          String?        @unique
  logoUrl       String         @default("/logo-gp.png")
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  meetings      Meeting[]
  missions      Mission[]
  planningEvents PlanningEvent[]
  users         User[]           @relation("DirectionMembers")
  messages      DirectionMessage[]
  discussion    DirectionDiscussion?
  roleDirectionRules RoleDirectionRule[]

  @@unique([name])
}

model DirectionMessage {
  id          String    @id @default(cuid())
  directionId String
  senderId    String
  parentId    String?
  body        String?
  fileName    String?
  fileUrl     String?
  mimeType    String?
  size        Int?
  createdAt   DateTime  @default(now())

  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parent      DirectionMessage?  @relation("DirectionMessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     DirectionMessage[] @relation("DirectionMessageReplies")

  @@index([directionId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentId])
}

model DirectionDiscussion {
  id          String   @id @default(cuid())
  directionId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  members     DirectionDiscussionMember[]
}

model DirectionDiscussionMember {
  id            String   @id @default(cuid())
  discussionId  String
  userId        String
  joinedAt      DateTime @default(now())

  discussion    DirectionDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([userId, joinedAt])
}

model Project {
  id            String         @id @default(cuid())
  name          String
  code          String?        @unique
  description   String?
  logoUrl       String         @default("/logo-gp.png")
  isActive      Boolean        @default(true)
  status        String         @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  createdById   String?
  /// Responsable du projet (rôle RESPONSABLE) — propriétaire du planning hebdomadaire
  responsibleId  String?
  /// Utilisateur désigné consolidateur du projet (validation réunions brouillon)
  consolidatorId String?
  /// Utilisateur désigné coordinateur du projet (validation finale réunions, missions, etc.)
  coordinatorId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy     User?          @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responsible   User?          @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  consolidator  User?          @relation("ProjectConsolidator", fields: [consolidatorId], references: [id], onDelete: SetNull)
  coordinator   User?          @relation("ProjectCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  meetings      Meeting[]
  missions      Mission[]
  planningEvents PlanningEvent[]
  files         ProjectFile[]
  users         User[]           @relation("ProjectMembers")
  messages      ProjectMessage[]
  discussion    ProjectDiscussion?

  @@unique([name])
  @@index([status])
  @@index([createdById])
  @@index([responsibleId])
  @@index([consolidatorId])
  @@index([coordinatorId])
}

/// Association rôle applicatif ↔ directions éligibles (configuration dynamique).
model RoleDirectionRule {
  id          String    @id @default(cuid())
  role        String
  directionId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@unique([role, directionId])
  @@index([role])
  @@index([directionId])
}

model ProjectMessage {
  id        String    @id @default(cuid())
  projectId String
  senderId  String
  parentId  String?
  body      String?
  fileName  String?
  fileUrl   String?
  mimeType  String?
  size      Int?
  createdAt DateTime  @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parent    ProjectMessage?  @relation("ProjectMessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   ProjectMessage[] @relation("ProjectMessageReplies")

  @@index([projectId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentId])
}

model ProjectDiscussion {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   ProjectDiscussionMember[]
}

model ProjectDiscussionMember {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  joinedAt     DateTime @default(now())

  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([userId, joinedAt])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  fileName     String
  fileUrl      String
  mimeType     String?
  size         Int?
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([projectId, createdAt])
}

// Historique des mots de passe – CDC §3.1.2 (interdiction de réutiliser les 3 derniers)
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RepertoireContact {
  id             String   @id @default(cuid())
  numero         Int      @default(0)
  prenomNom      String
  fonction       String?
  directionLabel String
  poste          String?
  directe        String?
  portable       String?
  /// Adresse e-mail professionnelle (optionnelle)
  email          String?
  ordre          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([directionLabel])
  @@index([ordre])
}
