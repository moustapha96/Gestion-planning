# ============================================================
# GESTION PLANNING — Backend .env (production tech-xuma.com)
# Copier vers backend/.env.production puis backend/.env sur la VM
# ============================================================

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gpadm_db?schema=public"

PORT=3001
NODE_ENV=production

# Origines autorisées (CORS + liens emails). Séparer par virgule si plusieurs.
FRONTEND_URL=https://g-planning.tech-xuma.com
BACKEND_URL=https://back-gp.tech-xuma.com

JWT_SECRET=CHANGEZ_MOI
JWT_REFRESH_SECRET=CHANGEZ_MOI
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ACTIVATION_EXPIRY=48h

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion Planning <noreply@example.com>"

WEEKLY_REPORT_EMAIL=admin@example.com

MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION=15
MAX_2FA_ATTEMPTS=5

SWAGGER_USER=admin
SWAGGER_PASS=CHANGEZ_MOI

APP_TIMEZONE=Africa/Dakar
TZ=Africa/Dakar
BACKUP_CRON_TIMEZONE=Africa/Dakar
