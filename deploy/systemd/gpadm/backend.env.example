# /var/www/gpadm/backend/.env — exemple VM

DATABASE_URL="postgresql://gestion_planning_app:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_planning?schema=public"
JWT_SECRET="changez-moi-longue-chaine-aleatoire"

HOST=127.0.0.1
PORT=3001

# URL vue dans le navigateur (IP ou nom de la VM + port frontend)
FRONTEND_URL="http://VOTRE_IP_OU_DOMAINE:9000"

# Origine du backend pour les liens e-mail (convocations : /api/public/...)
# Ex. http://10.5.49.131 si nginx proxy /api → backend, ou http://10.5.49.131:3001 en direct
BACKEND_URL="http://VOTRE_IP_OU_DOMAINE"

NODE_ENV=production

# Fuseau horaire (Dakar) — crons, « aujourd\'hui. », e-mails
APP_TIMEZONE=Africa/Dakar
TZ=Africa/Dakar
BACKUP_CRON_TIMEZONE=Africa/Dakar

DISABLE_BACKUP_CRON=false
