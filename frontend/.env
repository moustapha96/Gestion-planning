# ============================================================
# GESTION PLANNING — Frontend .env
# CDC v2 — Mars 2026
# ============================================================
# Toutes les variables DOIVENT commencer par VITE_ pour être
# accessibles via import.meta.env dans le code Vite.
# ============================================================

# -----------------------------------------------------------
# URL de l'API backend (CDC §5.3)
# Dev local : laisser vide ou mettre http://localhost:3001
# Mobile Capacitor : mettre l'IP réseau du serveur
#   ex: http://192.168.1.100:3001
# Production : https://api.mondomaine.com
# -----------------------------------------------------------
VITE_API_URL=http://localhost:3001/api

# Fuseau applicatif (GMT+0) — aligné sur le backend
VITE_APP_TIMEZONE=UTC
