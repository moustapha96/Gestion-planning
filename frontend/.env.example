# URL du backend (sans /api à la fin).
# En dev web : ne pas définir → le proxy Vite (port 5173) redirige /api et /uploads vers localhost:3001.
# En build production ou app mobile : définir l'URL publique du backend.
# VITE_API_URL=https://api.votredomaine.com

# Fuseau applicatif GMT+0 (aligné backend APP_TIMEZONE=UTC)
# VITE_APP_TIMEZONE=UTC
